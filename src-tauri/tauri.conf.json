{
  "productName": "VeloClips",
  "version": "1.0.3",
  "identifier": "com.VeloClips.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "fullscreen": false,
        "resizable": true,
        "title": "VeloClips",
        "width": 800,
        "height": 600,
        "decorations": false, 
        "visible": true
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["**/*", "C:/**", "D:/**", "E:/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "ai_engine/**/*",
      "DaVinci_Integration/**/*",
      "Templates/**/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "bin/audio_analyzer",
      "bin/chat_analyzer",
      "bin/clip_downloader",
      "bin/face_tracker",
      "bin/video_scraper"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://raw.githubusercontent.com/StackSBix29/VeloClips/main/updater.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZGQTkyMEZCQ0E3QUJENEEKUldSS3ZYcksreUNwYjZ5T3FoUDJMVEt0ZUFJVnpkc2wvMTFPTzNBbU5UMWdJUGpHUS9tMGlYNnkK"
    }
  }
}