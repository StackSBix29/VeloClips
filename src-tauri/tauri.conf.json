{
  "productName": "VeloClips",
  "version": "0.1.0",
  "identifier": "com.VeloClips.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
  {
    "fullscreen": false,
    "resizable": true,
    "title": "VeloClips",
    "width": 800,
    "height": 600,
    "decorations": false, 
    "visible": true
  }
],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["**/*", "C:/**", "D:/**", "E:/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}